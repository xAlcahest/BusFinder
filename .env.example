# Copy to .env and fill in. `docker compose` reads .env automatically.
# .env is in .dockerignore: it never ends up inside the image.

# ---------------------------------------------------------------------------
# Where the image comes from
# ---------------------------------------------------------------------------

# Registry reference WITHOUT the tag. release.sh pushes here, deploy.sh pulls.
#   GitHub Container Registry: ghcr.io/<your-user>/busfinder
#   Docker Hub:                docker.io/<your-user>/busfinder
PROBUS_IMAGE=ghcr.io/CHANGEME/busfinder

# Tag actually run. deploy.sh rewrites this to the version it just released,
# so the server always states which build it is on instead of chasing :latest.
PROBUS_TAG=latest

# Target architecture of the SERVER, not of this machine. A VPS on Ampere or
# Graviton is linux/arm64 and an amd64 image will not start on it.
PROBUS_PLATFORM=linux/amd64

# ---------------------------------------------------------------------------
# Host wiring
# ---------------------------------------------------------------------------

# Where the container port is published. Default is loopback only: on a server
# the outside world must arrive through Caddy, never straight at the app.
# On a LAN box with no TLS, set 0.0.0.0:3200 to reach it from other devices.
PROBUS_BIND=127.0.0.1:3200

# Host directory holding the three databases. A bind mount, deliberately: a
# named volume is one `docker compose down -v` away from destroying sync.db,
# which has no upstream and cannot be regenerated by anything.
PROBUS_DATA=./data

# Hard ceiling for the container. The first boot ingests a ~214 MB
# stop_times.txt, so anything under about 1.5g risks an OOM kill mid-ingest.
PROBUS_MEM_LIMIT=2g

# ---------------------------------------------------------------------------
# TLS (only used by the `tls` profile)
# ---------------------------------------------------------------------------

# Domain whose A/AAAA record already points at this server. Caddy obtains and
# renews the certificate itself; nothing else has to be configured.
PROBUS_DOMAIN=busfinder.example.com

# Address Let's Encrypt uses for expiry warnings.
PROBUS_ACME_EMAIL=you@example.com

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------

# Sent as the User-Agent to Nominatim, which requires a way to reach the
# operator. Leaving the placeholder here risks being blocked from geocoding.
PROBUS_CONTACT=you@example.com

# Set to `off` to disable address geocoding entirely: the journey planner then
# works stop-to-stop only and the app makes no outbound calls to Nominatim.
PROBUS_GEOCODING=on

# Public URL, used by scripts/smoke.ts as the deploy gate target.
PROBUS_URL=https://busfinder.example.com

# ---------------------------------------------------------------------------
# Deployment target
# ---------------------------------------------------------------------------

# SSH destination for deploy.sh, as user@host. Key-based auth only: the script
# is non-interactive and will not prompt for a password.
PROBUS_SSH=root@203.0.113.10

# Directory on the server holding compose.yaml, Caddyfile, .env and ./data.
PROBUS_REMOTE_DIR=/opt/busfinder
